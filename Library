-- CM UI LIBRARY v1.1 - SAFE COMPONENT SHOWCASE
--==================================================
-- Run CM_UI_Library_v1.1.lua first, then execute this file.
-- The fallback below can also load the local library when the executor
-- supports readfile/isfile.

local environment = (typeof(getgenv) == "function" and getgenv()) or _G
local Library = environment.CM_UI_LIBRARY or _G.CM_UI_LIBRARY

if not Library and typeof(readfile) == "function" and typeof(loadstring) == "function" then
	local candidates = {
		[[C:\Users\xxsup\Documents\Codex\2026-08-22\np\outputs\CM_UI_Library_v1.1.lua]],
		[[C:\Users\xxsup\Downloads\CM HUB UI LIBRARY\CM_UI_Library.lua]],
		"CM_UI_Library_v1.1.lua",
		"CM_UI_Library.lua",
	}

	for _, path in ipairs(candidates) do
		local canRead = typeof(isfile) ~= "function" or isfile(path)
		if canRead then
			local ok, result = pcall(function()
				return loadstring(readfile(path))()
			end)
			if ok and result then
				Library = result
				break
			end
		end
	end
end

assert(Library, "CM UI Library is not loaded. Execute CM_UI_Library_v1.1.lua first.")

local Window = Library:CreateWindow({
	Title = "CM Hub • UI Showcase",
	Subtitle = "Improved buttons and vector tab icons",
	Size = UDim2.fromOffset(610, 470),
	TabWidth = 158,
})

local MainTab = Window:AddTab({ Title = "Main", Icon = "home" })
local PlayerTab = Window:AddTab({ Title = "Player", Icon = "user" })
local VisualsTab = Window:AddTab({ Title = "Visuals", Icon = "eye" })
local MiscTab = Window:AddTab({ Title = "Misc", Icon = "misc" })

local Welcome = MainTab:NewSection("Welcome")

Welcome:AddParagraph({
	Title = "CM UI Library v1.1",
	Content = "This showcase demonstrates the improved action buttons, line-drawn tab icons, active-tab rail, toggles, sliders, dropdowns and input controls.",
})

Welcome:AddButton({
	Title = "Test Action Button",
	Description = "Shows the updated hover, press and arrow treatment.",
	Callback = function()
		Library:Notify({
			Title = "Action successful",
			Content = "The improved CM button callback fired correctly.",
			Duration = 4,
		})
	end,
})

Welcome:AddButton({
	Title = "Open Confirmation Dialog",
	Description = "Preview the redesigned primary and secondary dialog buttons.",
	Icon = "info",
	Callback = function()
		Window:Dialog({
			Title = "CM UI Dialog",
			Content = "Both buttons now have clear hover and pressed states.",
			Buttons = {
				{
					Title = "Confirm",
					Callback = function()
						Library:Notify("Confirmed from the example UI.")
					end,
				},
				{ Title = "Cancel" },
			},
		})
	end,
})

local Automation = MainTab:NewSection("Automation Controls")

local AutoDemo = Automation:AddToggle("ExampleAutoDemo", {
	Title = "Auto Demo",
	Description = "Example toggle only; it does not modify the game.",
	Default = false,
})

AutoDemo:OnChanged(function(value)
	Library:Notify({
		Title = "Auto Demo",
		Content = value and "Enabled" or "Disabled",
		Duration = 2,
	})
end)

local Delay = Automation:AddSlider("ExampleDelay", {
	Title = "Action Delay",
	Description = "Drag or click anywhere on the slider.",
	Default = 1.5,
	Min = 0.1,
	Max = 5,
	Rounding = 1,
	Suffix = "s",
})

local PlayerControls = PlayerTab:NewSection("Player Preferences")

PlayerControls:AddInput("ExamplePlayerName", {
	Title = "Target Player",
	Description = "Input styling and mobile keyboard test.",
	Placeholder = "Username...",
	Finished = true,
})

PlayerControls:AddDropdown("ExampleMovement", {
	Title = "Movement Mode",
	Description = "Single-select dropdown example.",
	Values = { "Normal", "Sprint", "Flight" },
	Default = 1,
})

PlayerControls:AddKeybind("ExampleKeybind", {
	Title = "Toggle Window",
	Description = "Example rebinding control.",
	Default = "RightControl",
	Mode = "Toggle",
	Callback = function()
		Library:ToggleUI()
	end,
})

local VisualControls = VisualsTab:NewSection("Appearance")

VisualControls:AddToggle("ExampleESP", {
	Title = "Preview Highlight",
	Description = "UI-only example state.",
	Default = false,
})

VisualControls:AddColorpicker("ExampleColor", {
	Title = "Accent Preview",
	Description = "HSV color picker with transparency support.",
	Default = Color3.fromRGB(105, 135, 255),
	Transparency = 0,
})

VisualControls:AddDropdown("ExampleQuality", {
	Title = "Visual Quality",
	Description = "Try the redesigned dropdown option buttons.",
	Values = { "Low", "Medium", "High", "Ultra" },
	Default = 3,
})

local MiscControls = MiscTab:NewSection("Utilities")

MiscControls:AddButton({
	Title = "Show Notification",
	Description = "The close icon is vector-drawn, so it cannot become a square box.",
	Icon = "bolt",
	Callback = function()
		Library:Notify({
			Title = "CM UI Library",
			Content = "Notification controls are working.",
			SubContent = "Click the line-drawn X to close this notification.",
			Duration = 6,
		})
	end,
})

MiscControls:AddButton({
	Title = "Reset Example Values",
	Description = "Restores the toggle and slider to their defaults.",
	Icon = "settings",
	Callback = function()
		AutoDemo:SetValue(false)
		Delay:SetValue(1.5)
		Library:Notify("Example values reset.")
	end,
})

Window:SelectTab(MainTab)

Library:Notify({
	Title = "CM UI Showcase loaded",
	Content = "The updated library and example initialized successfully.",
	SubContent = "Use RightControl or the floating CM button to reopen the window.",
	Duration = 5,
})

print("[CM UI Example] Loaded successfully")
