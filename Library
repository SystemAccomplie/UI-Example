-- CHANGE ONLY THIS URL after uploading CM_UI_Library_v1.9.lua:
local LIBRARY_URL = "https://pastefy.app/SjtX1HrW/raw"

local Library = loadstring(game:HttpGet(LIBRARY_URL))()

--==================================================
-- HUB SETTINGS
--==================================================

local HUB_NAME = "CM Example Hub"
local HUB_SUBTITLE = "Complete 3D Folder & Component Showcase"

local Window = Library:CreateWindow({
	Title = HUB_NAME,
	Subtitle = HUB_SUBTITLE,
	Size = UDim2.fromOffset(610, 480),
	TabWidth = 158,
})

--==================================================
-- TABS (3D Folder Style)
--==================================================

local MainTab = Window:AddTab({ Title = "Main", Icon = "home" })
local PlayerTab = Window:AddTab({ Title = "Player", Icon = "user" })
local VisualsTab = Window:AddTab({ Title = "Visuals", Icon = "eye" })
local ComponentsTab = Window:AddTab({ Title = "Components", Icon = "tools" })
local IconsTab = Window:AddTab({ Title = "Icons", Icon = "sparkles" })

--==================================================
-- MAIN TAB - 3D FOLDERS
--==================================================

local WelcomeFolder = MainTab:AddFolder({
	Title = "Welcome & Basics",
	Description = "Getting started, alerts and buttons",
	Icon = "home",
	Default = true, -- Open by default
})

WelcomeFolder:AddLabel({
	Title = "Welcome to <b>CM Example Hub</b>!",
})

WelcomeFolder:AddParagraph({
	Title = "3D Folder System Active",
	Content = "Tabs and features now live in 3D folders! Click folder headers to expand or collapse. Features are neatly organized and cleanly animated.",
})

WelcomeFolder:AddButton({
	Title = "Normal Action Button",
	Callback = function()
		Library:Notify({
			Title = "Normal Button",
			Content = "The button inside the folder fired successfully.",
			Duration = 3,
		})
	end,
})

local LoadingButton
LoadingButton = WelcomeFolder:AddButton({
	Title = "Loading State Button",
	Icon = "play",
	LoadingText = "Please wait...",
	Callback = function()
		LoadingButton:SetLoading(true)
		task.delay(2, function()
			LoadingButton:SetLoading(false)
			Library:Notify({
				Type = "Success",
				Title = "Finished",
				Content = "The loading state completed successfully.",
				Duration = 3,
			})
		end)
	end,
})

WelcomeFolder:AddButton({
	Title = "Open Confirmation Dialog",
	Icon = "info",
	Callback = function()
		Window:Dialog({
			Title = "Example Dialog",
			Content = "Do you want to confirm this example action?",
			Buttons = {
				{
					Title = "Confirm",
					Callback = function()
						Library:Notify({
							Title = "Confirmed",
							Content = "You pressed the primary dialog button.",
							Duration = 3,
						})
					end,
				},
				{
					Title = "Cancel",
					Callback = function()
						print("[CM Example] Dialog cancelled")
					end,
				},
			},
		})
	end,
})

local AutomationFolder = MainTab:AddFolder({
	Title = "Automation & Loops",
	Description = "Farming, collecting, and macros",
	Icon = "bot",
	Default = false, -- Starts closed
})

local AutoFarm = AutomationFolder:AddToggle("ExampleAutoFarm", {
	Title = "Auto Farm",
	Default = false,
})

local AutoCollect = AutomationFolder:AddToggle("ExampleAutoCollect", {
	Title = "Auto Collect",
	Default = false,
})

--==================================================
-- PLAYER TAB - 3D FOLDERS
--==================================================

local MovementFolder = PlayerTab:AddFolder({
	Title = "Movement Settings",
	Description = "WalkSpeed and JumpPower",
	Icon = "speed",
	Default = true,
})

local WalkSpeed = MovementFolder:AddSlider("ExampleWalkSpeed", {
	Title = "Walk Speed",
	Default = 16,
	Min = 16,
	Max = 200,
	Rounding = 0,
	Suffix = " studs/s",
})

local JumpPower = MovementFolder:AddSlider("ExampleJumpPower", {
	Title = "Jump Power",
	Default = 50,
	Min = 50,
	Max = 300,
	Rounding = 0,
})

local InputFolder = PlayerTab:AddFolder({
	Title = "Inputs & Keybinds",
	Description = "Text and hotkeys",
	Icon = "sliders",
	Default = false,
})

local PlayerInput = InputFolder:AddInput("ExamplePlayerInput", {
	Title = "Target Player",
	Default = "",
	Placeholder = "Enter username...",
	Finished = true,
})

local ExampleKeybind = InputFolder:AddKeybind("ExampleKeybind", {
	Title = "Hub Keybind",
	Default = "F",
	Mode = "Toggle",
})

--==================================================
-- VISUALS TAB - 3D FOLDERS
--==================================================

local ESPFolder = VisualsTab:AddFolder({
	Title = "ESP & Visuals",
	Description = "Chams, boxes, and colors",
	Icon = "eye",
	Default = true,
})

local PlayerESP = ESPFolder:AddToggle("ExamplePlayerESP", {
	Title = "Player ESP",
	Default = false,
})

local ESPMode = ESPFolder:AddDropdown("ExampleESPMode", {
	Title = "ESP Mode",
	Values = { "Box", "Highlight", "Chams", "Name", "Tracer", "Skeleton" },
	Multi = false,
	Default = 1,
})

local ESPColor = ESPFolder:AddColorpicker("ExampleESPColor", {
	Title = "ESP Color",
	Default = Color3.fromRGB(16, 185, 129),
	Transparency = 0,
})

--==================================================
-- COMPONENTS TAB - 3D FOLDERS
--==================================================

local ControlsFolder = ComponentsTab:AddFolder({
	Title = "UI Controls Showcase",
	Description = "All interactive control types",
	Icon = "tools",
	Default = true,
})

ControlsFolder:AddButton({
	Title = "Action Button",
	Callback = function()
		print("[CM Example] Action clicked")
	end,
})

ControlsFolder:AddToggle("ShowcaseToggle", {
	Title = "Showcase Toggle",
	Default = true,
})

ControlsFolder:AddSlider("ShowcaseSlider", {
	Title = "Showcase Slider",
	Default = 75,
	Min = 0,
	Max = 100,
})

ControlsFolder:AddDropdown("ShowcaseDropdown", {
	Title = "Showcase Dropdown",
	Values = { "First Option", "Second Option", "Third Option" },
	Default = 1,
})

--==================================================
-- ICONS TAB - 3D FOLDERS
--==================================================

local IconsFolder = IconsTab:AddFolder({
	Title = "Vector Glyphs Showcase",
	Description = "Line-drawn icons demonstration",
	Icon = "sparkles",
	Default = true,
})

IconsFolder:AddParagraph({
	Title = "Crisp Vector Line Glyphs",
	Content = "Over 100+ line icons drawn natively with Frames - zero emoji fallbacks, pixel-perfect on any device!",
})

--==================================================
-- STARTUP
--==================================================

Window:SelectTab(MainTab)

Library:Notify({
	Type = "Success",
	Title = HUB_NAME,
	Content = "3D Folder System loaded successfully!",
	SubContent = "Folders and smooth open/close tab transitions are active.",
	Duration = 6,
})

print("[CM Example] 3D Folder Hub loaded successfully")
